{
  "manifest_version": 3,
  "name": "AI Quiz Screen Assistant",
  "version": "1.0.0",
  "description": "Upload your study documents, share your screen, and get instant quiz answers powered by AI.",
  "permissions": [
    "desktopCapture",
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "windows",
    "sidePanel"
  ],
  "host_permissions": ["http://localhost:3001/*"],
  "action": {
    "default_title": "AI Quiz Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "src/popup/index.html"
  },
  "background": {
    "service_worker": "src/background/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content.ts"],
      "css": ["src/content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/capture/capture.html", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
